DATABASE_URL=postgres://storemesh:storemesh@localhost:5432/storemesh_users?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
REDIS_URL=redis://localhost:6379

GRPC_PORT=50051
HTTP_PORT=8080
ENVIRONMENT=development

JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=168h

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

OTLP_ENDPOINT=localhost:4317
SERVICE_NAME=storemesh-user-service
SERVICE_VERSION=1.0.0
